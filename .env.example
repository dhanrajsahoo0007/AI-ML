# PostgreSQL (local: docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aiml

# Redis (local: docker-compose)
REDIS_URL=redis://localhost:6380

# Host port mapped to the Next.js container when using:
#   docker compose --profile app up
# If 3000 is already in use on your machine, set WEB_HOST_PORT=3001 and open http://localhost:3001
WEB_HOST_PORT=3000

# Optional: set in production
# NODE_ENV=production
