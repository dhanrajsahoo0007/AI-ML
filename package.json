{
  "name": "tokenstoscale",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w web",
    "e2e": "npm run e2e -w web",
    "knip": "knip",
    "check:agents-md": "npm run check:agents-md -w web",
    "check:brand": "npm run check:brand -w web"
  },
  "devDependencies": {
    "knip": "^5.88.1",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
