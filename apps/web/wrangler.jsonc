// Cloudflare Workers config for the OpenNext build (plan §7). No Cloudflare account exists yet:
// everything here works locally (`npm run preview -w web`, i.e. `opennextjs-cloudflare preview`).
// Bindings that need account resources are present but commented, with a TODO each. Names are
// placeholders; IDs are filled in by the owner once the account exists. Never put secrets here:
// secrets are set with `wrangler secret put <NAME> --env <env>` (names only in AGENTS.md).
//
// Environments (`--env`): the top level is local (`wrangler dev`, `opennextjs-cloudflare preview`);
// `preview` holds one version per PR (preview URLs), `staging` is deployed from `development`,
// `production` from `main` (.github/workflows/deploy.yml, preview.yml + preview-deploy.yml).
// Bindings and `vars` are not inherited by environments, so each environment repeats them.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "origins-ai-learn",
  // worker.mjs wraps OpenNext's generated .open-next/worker.js (Sentry per request when SENTRY_DSN is set; room
  // for a queue consumer). Build that first: `npm run cf:build -w web`.
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    // _next/static, fonts, SVGs and public files; also the prerendered pages under
    // cdn-cgi/_next_cache/ (readable by the Worker only) used by the static-assets cache.
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": false,
  // APP_ENV is also inlined at build by next.config.ts (section states are resolved per build); the
  // runtime value labels logs. SECTIONS_KILL (the §5.1.1 kill switch) is a secret, not a var, so a
  // deploy never resets it: `wrangler secret put SECTIONS_KILL --env production` (e.g. "dsa,cloud").
  "vars": { "APP_ENV": "local" },

  // R2 incremental cache (open-next.config.ts): used by builds with the paywall on, so full premium pages are
  // never public static assets (plan §9.2). Locally (`npm run preview -w web`) wrangler simulates the bucket;
  // nothing is created in any account.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "origins-ai-learn-cache-local" }],

  // Workers Rate Limiting for /api/* (plan §11.6), one binding per named limit in src/server/rate-limit.ts (same
  // numbers; src/server/rate-limit.test.ts keeps them in sync). namespace_id is an integer we choose, unique per
  // account (no resource to create): 1xxx local, 2xxx preview, 3xxx staging, 4xxx production, so environments
  // never share counters. Counters are per Cloudflare location; the hourly caps are zone rules (owner).
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_SESSION", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_ACCOUNT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PROGRESS", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_CHECKOUT", "namespace_id": "1005", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_PORTAL", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_ENTITLEMENTS", "namespace_id": "1007", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_TEST", "namespace_id": "1008", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SIGNUP", "namespace_id": "1009", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_SIGNUP_EMAIL", "namespace_id": "1010", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_EMAIL_LINK", "namespace_id": "1011", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CSP", "namespace_id": "1012", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_VITALS", "namespace_id": "1013", "simple": { "limit": 60, "period": 60 } },
  ],

  // ── Account-bound bindings (uncomment per environment once the resources exist) ──────────────────
  // TODO(account): per environment, the R2 cache bucket (required for preview and staging, which build
  // with the paywall on) plus the media buckets:
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "origins-ai-learn-cache-<env>" },
  //   // Public media (media.<domain>), large free assets (plan §5.6).
  //   { "binding": "MEDIA_PUBLIC", "bucket_name": "origins-ai-learn-media-public" },
  //   // Premium media, served only through the Worker after an entitlement check.
  //   { "binding": "MEDIA_PRIVATE", "bucket_name": "origins-ai-learn-media-private" },
  // ],
  // TODO(account, Phase 4): Hyperdrive in front of Neon, one config per environment (`wrangler hyperdrive create`).
  // Only /api/* handlers and the account pages use it (src/server/db/client.ts reads it per request; without it,
  // DATABASE_URL). Locally the binding is optional: `localConnectionString` is the Docker Postgres.
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id-local>", "localConnectionString": "postgres://origins:origins@127.0.0.1:54329/origins_dev" }],
  // TODO(account): Analytics Engine dataset for paywall, checkout, webhook and web-vitals metrics (plan §10.5;
  // src/server/edge/analytics.ts is a no-op without it). The dataset is created on first write.
  // "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "origins_ai_learn_local" }],
  // TODO(account): Cloudflare Queue for transactional email, so /api/* never waits on Resend. This Worker is both
  // producer (EMAIL_QUEUE → enqueueEmail() in src/features/email/queue.ts) and consumer (handleEmailQueue() in
  // src/features/email/queue-consumer.ts, wired as the Worker entry's queue() handler). Messages that still fail
  // after max_retries (backoff 30 s doubling to 1 h, about 2 h in all) go to the dead-letter queue, kept for
  // inspection and replay. max_concurrency 1 stays under Resend's default API rate limit. Without the binding
  // email is sent inline. The owner creates both queues per environment first:
  // `npx wrangler queues create origins-ai-learn-email-<env>` and `npx wrangler queues create origins-ai-learn-email-dlq-<env>`.
  // Locally wrangler simulates queues (no account); worker.mjs already wires the consumer, so only this block is left.
  // "queues": {
  //   "producers": [{ "binding": "EMAIL_QUEUE", "queue": "origins-ai-learn-email-local" }],
  //   "consumers": [{ "queue": "origins-ai-learn-email-local", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 1, "dead_letter_queue": "origins-ai-learn-email-dlq-local" }],
  // },

  "env": {
    // One Worker (origins-ai-learn-preview) holds a version per PR, each with its own preview URL
    // (`wrangler versions upload --env preview --preview-alias pr-<n>`). Never routed to a domain.
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "vars": { "APP_ENV": "preview" },
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_SESSION", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_ACCOUNT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_PROGRESS", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_CHECKOUT", "namespace_id": "2005", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_PORTAL", "namespace_id": "2006", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_ENTITLEMENTS", "namespace_id": "2007", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_TEST", "namespace_id": "2008", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "2009", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SIGNUP_EMAIL", "namespace_id": "2010", "simple": { "limit": 2, "period": 60 } },
        { "name": "RL_EMAIL_LINK", "namespace_id": "2011", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_CSP", "namespace_id": "2012", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_VITALS", "namespace_id": "2013", "simple": { "limit": 60, "period": 60 } },
      ],
      // TODO(account): r2_buckets as above (preview names), and:
      // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id-preview>" }],
      // "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "origins_ai_learn_preview" }],
      // TODO(account): the transactional email queue (src/features/email/queue.ts), preview names; see the top level.
      // "queues": {
      //   "producers": [{ "binding": "EMAIL_QUEUE", "queue": "origins-ai-learn-email-preview" }],
      //   "consumers": [{ "queue": "origins-ai-learn-email-preview", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 1, "dead_letter_queue": "origins-ai-learn-email-dlq-preview" }],
      // },
    },
    // Deployed from `development`. TODO(account): route `staging.<domain>` once the zone exists:
    // "routes": [{ "pattern": "staging.<domain>", "custom_domain": true }],
    // No per-version preview URLs (security review M2): the smoke tests pin a version with the
    // Cloudflare-Workers-Version-Overrides header on workers.dev instead.
    "staging": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "APP_ENV": "staging" },
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_SESSION", "namespace_id": "3002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_ACCOUNT", "namespace_id": "3003", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_PROGRESS", "namespace_id": "3004", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_CHECKOUT", "namespace_id": "3005", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_PORTAL", "namespace_id": "3006", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_ENTITLEMENTS", "namespace_id": "3007", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_TEST", "namespace_id": "3008", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "3009", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SIGNUP_EMAIL", "namespace_id": "3010", "simple": { "limit": 2, "period": 60 } },
        { "name": "RL_EMAIL_LINK", "namespace_id": "3011", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_CSP", "namespace_id": "3012", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_VITALS", "namespace_id": "3013", "simple": { "limit": 60, "period": 60 } },
      ],
      // TODO(account): r2_buckets as above (staging names), and:
      // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id-staging>" }],
      // "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "origins_ai_learn_staging" }],
      // TODO(account): the transactional email queue (src/features/email/queue.ts), staging names; see the top level.
      // "queues": {
      //   "producers": [{ "binding": "EMAIL_QUEUE", "queue": "origins-ai-learn-email-staging" }],
      //   "consumers": [{ "queue": "origins-ai-learn-email-staging", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 1, "dead_letter_queue": "origins-ai-learn-email-dlq-staging" }],
      // },
    },
    // Deployed from `main` through the `production` GitHub environment. workers.dev stays on because
    // the deploy smoke tests use it (Bot Fight Mode on the custom domain blocks CI runners); middleware
    // redirects page requests there to the canonical host unless they carry the SMOKE_KEY secret
    // (src/server/edge/host-guard.ts). No per-version preview URLs: every uploaded version (the 10% canary,
    // old ones with since-fixed bugs) would stay reachable with production secrets (security review M2).
    // TODO(account): "routes": [{ "pattern": "<domain>", "custom_domain": true }, { "pattern": "www.<domain>", "custom_domain": true }],
    "production": {
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "APP_ENV": "production" },
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "4001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_SESSION", "namespace_id": "4002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_ACCOUNT", "namespace_id": "4003", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_PROGRESS", "namespace_id": "4004", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_CHECKOUT", "namespace_id": "4005", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_PORTAL", "namespace_id": "4006", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_ENTITLEMENTS", "namespace_id": "4007", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_TEST", "namespace_id": "4008", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNUP", "namespace_id": "4009", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SIGNUP_EMAIL", "namespace_id": "4010", "simple": { "limit": 2, "period": 60 } },
        { "name": "RL_EMAIL_LINK", "namespace_id": "4011", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_CSP", "namespace_id": "4012", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_VITALS", "namespace_id": "4013", "simple": { "limit": 60, "period": 60 } },
      ],
      // TODO(account): r2_buckets as above (production names), and:
      // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id-production>" }],
      // "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "origins_ai_learn_production" }],
      // TODO(account): the transactional email queue (src/features/email/queue.ts), production names; see the top level.
      // "queues": {
      //   "producers": [{ "binding": "EMAIL_QUEUE", "queue": "origins-ai-learn-email-production" }],
      //   "consumers": [{ "queue": "origins-ai-learn-email-production", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8, "max_concurrency": 1, "dead_letter_queue": "origins-ai-learn-email-dlq-production" }],
      // },
    },
  },
}
