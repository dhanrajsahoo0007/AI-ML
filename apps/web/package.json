{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "mermaid": "node scripts/render-mermaid.mjs",
    "assets": "node --import ./scripts/ts-hooks.mjs scripts/build-assets.ts",
    "asset:new": "node --import ./scripts/ts-hooks.mjs scripts/build-assets.ts new",
    "asset:find": "node --import ./scripts/ts-hooks.mjs scripts/build-assets.ts find",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prebuild": "node scripts/content-dates.mjs && node scripts/render-mermaid.mjs && node --import ./scripts/ts-hooks.mjs scripts/build-assets.ts",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "mkdir -p .wrangler/types && wrangler types --env-interface CloudflareEnv --include-runtime=false --strict-vars=false .wrangler/types/cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:agents-md": "tsx scripts/check-agents-md.ts",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:visual": "bash tests/e2e/visual-docker.sh",
    "e2e:visual:update": "bash tests/e2e/visual-docker.sh --update-snapshots",
    "size": "size-limit",
    "lighthouse": "mkdir -p test-results && cd test-results && lhci autorun --config=../lighthouserc.cjs",
    "content-check": "node --import ./scripts/ts-hooks.mjs scripts/content-check.ts --warn-cloud-questions",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import ./scripts/ts-hooks.mjs src/server/db/migrate.ts",
    "db:seed:test": "node --import ./scripts/ts-hooks.mjs src/server/db/seed-test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@opennextjs/cloudflare": "^1.20.16",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^11.11.0",
    "@types/js-yaml": "^4.0.9",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.15",
    "js-yaml": "^4.3.2",
    "katex": "^0.16.45",
    "lucide-react": "^0.487.0",
    "mermaid": "^11.17.2",
    "next": "^15.4.5",
    "next-mdx-remote": "^5.0.0",
    "pg": "^8.23.1",
    "posthog-js": "^1.447.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@excalidraw/utils": "0.1.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@size-limit/file": "^13.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^15.4.5",
    "playwright": "^1.65.0",
    "shadcn": "^4.23.0",
    "sharp": "^0.34.5",
    "size-limit": "^13.1.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
