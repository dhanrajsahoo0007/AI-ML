{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "mermaid": "node scripts/render-mermaid.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prebuild": "node scripts/content-dates.mjs && node scripts/render-mermaid.mjs",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:agents-md": "tsx scripts/check-agents-md.ts",
    "e2e:chromium": "playwright test --project=chromium",
    "content-check": "node --import ./scripts/ts-hooks.mjs scripts/content-check.ts --warn-cloud-questions"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@radix-ui/react-slot": "^1.1.2",
    "@types/js-yaml": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.15",
    "js-yaml": "^4.3.2",
    "katex": "^0.16.45",
    "lucide-react": "^0.487.0",
    "mermaid": "^11.17.2",
    "next": "^15.4.5",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.4.5",
    "playwright": "^1.65.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
